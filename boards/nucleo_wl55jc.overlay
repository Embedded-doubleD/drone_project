#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
    aliases {
        /* RGB LED Alias */
        led-red = &red_led_node;
        led-green = &green_led_node;
        led-blue = &blue_led_node;

        /* Sensor Input */
        ldr-pwr = &ldr_pwr_node;
        analog-in-pin = &zephyr_user;

        /* User Buttons & Buses */
        sw0 = &user_button_2;
        i2c-bus = &i2c1;
        gps = &usart2;
    };

    /* RGB LED (Common Anode) */
    rgb_leds {
        compatible = "gpio-leds";
        
        red_led_node: red_led_node {
            gpios = <&gpiob 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
            label = "RGB_LED_RED";
        };
        
        green_led_node: green_led_node {
            gpios = <&gpioc 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
            label = "RGB_LED_GREEN";
        };
        
        blue_led_node: blue_led_node {
            gpios = <&gpioa 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
            label = "RGB_LED_BLUE";
        };
    };

    /* On-Demand Power Supply Node for LDR Divisor */
    ldr_pwr_supply {
        compatible = "gpio-leds";
        
        ldr_pwr_node: ldr_pwr_node {
            gpios = <&gpiob 2 GPIO_ACTIVE_HIGH>;
            label = "LDR_POWER_SUPPLY";
        };
    };


    /* ADC Channel Mapping for LDR */
    zephyr_user: zephyr,user {
        io-channels = <&adc1 5>; /* ADC1 Channel 5 mapped to PB1 */
    };
};

/* 5. I2C Bus Overlay for MPU6050 & Si7021 */
&i2c1 {
    status = "okay";
    pinctrl-0 = <&i2c1_scl_pa9 &i2c1_sda_pa10>;
    pinctrl-names = "default";
    clock-frequency = <I2C_BITRATE_STANDARD>; /* 100 kHz */

    /* MPU6050 Motion Sensor Node */
    mpu6050: mpu6050@68 {
        compatible = "i2c-device";
        reg = <0x68>;
        status = "okay";
        int-gpios = <&gpioa 6 GPIO_ACTIVE_HIGH>;
    };

    /* Si7021 Humidity & Temp Sensor Node */
    si7021: si7021@40 {
        compatible = "i2c-device";
        reg = <0x40>;
        status = "okay";
    };
};

/* 6. ADC Peripheral Enable */
&adc1 {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    adc_ldr_channel: channel@5 {
        reg = <5>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL"; /* 3.3V VREF */
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>; /* 12-bit ADC (0 - 4095) */
    };
};

/* 7. UART Peripheral for GPS Module */
&usart2 {
    status = "okay";
    current-speed = <9600>;
    pinctrl-0 = <&usart2_tx_pa2 &usart2_rx_pa3>;
    pinctrl-names = "default";
};
